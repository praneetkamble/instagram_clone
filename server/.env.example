# --- Core ---
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/instagram_clone   # leave empty to use an in-memory DB (dev only)
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_too
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:3000            # comma-separated list of allowed origins
PUBLIC_URL=http://localhost:5000            # used to build URLs of uploaded media
GROQ_API=                                   # existing AI caption feature

# --- Admin seed (npm run seed) ---
ADMIN_EMAIL=admin@instai.dev
ADMIN_PASSWORD=Admin@12345

# --- Razorpay (leave empty for built-in mock checkout) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (SMTP). Empty => emails/OTPs are printed to the server console ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="InstAI <no-reply@instai.dev>"

# --- SMS (Twilio OR Fast2SMS). Empty => SMS OTPs are printed to the server console ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
FAST2SMS_API_KEY=

# --- Security tuning (optional) ---
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=3
OTP_MAX_FAILURES=5
OTP_LOCK_MIN=15
OTP_RESEND_COOLDOWN_SEC=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MIN=15
MAX_SCHEDULED_POSTS=2
SEED_DEMO=true
